<?xml version="1.0" encoding="utf-8"?>
<!-- 纸片底 + 双线框（报头风格边框） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper_card" />
            <stroke android:width="2dp" android:color="@color/ink" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/ink" />
        </shape>
    </item>
</layer-list>
